# Root cruft guard — QA screenshots belong in e2e/, never the repo root; no abandoned scaffolds
/.v2-scaffold/
/*.png
/*.jpg
/*.jpeg

# Build caches + generated artifacts (regenerated; never commit)
.angular/
.nx/
storybook-static/
*.tsbuildinfo
.eslintcache
*.log
# Generated drift report (written by validate-feature-drift)
_drift-report.json
**/_drift-report.json

# Vite transient config bundle (esbuild temp)
vite.config.*.timestamp-*
*.timestamp-*.mjs

# MkDocs build output
docs/site/
# Root editor e2e — same disposable-artifact class as the per-app entries below
e2e/screenshots/
apps/project-sites/e2e/screenshots/
apps/project-sites/test-results*/
apps/project-sites/test-results-*
apps/project-sites/frontend/e2e/screenshots/
apps/project-sites/frontend/test-results*/

# Probe/QA scratch screenshots — generated by e2e/admin-verify + e2e/site-quality probes
# (the `_`-prefixed PNGs) and by ad-hoc app-root captures. They are disposable artifacts,
# never committed (baselines live in e2e/__snapshots__/). Keeps `git status` clean.
apps/project-sites/e2e/admin-verify/*.png
apps/project-sites/e2e/site-quality/*.png
apps/project-sites/*.png
# Probe JSON reports — regenerated every run (contract-sweep writes _ADMIN_CONTRACT_REPORT.json;
# the loop reads its `.done` field). Disposable per-fire artifacts, never source → keep untracked
# so they can't be accidentally committed + don't clutter `git status`.
apps/project-sites/_ADMIN_CONTRACT_REPORT.json
