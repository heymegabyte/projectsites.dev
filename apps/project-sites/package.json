{
  "name": "@project-sites/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "e2e:seed": "node scripts/e2e-seed.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:container:image": "node --test scripts/__tests__/container_image.test.mjs",
    "test:container:freshness": "node --test scripts/__tests__/skills_freshness.test.mjs",
    "test:container:e2e": "node --test scripts/__tests__/build_e2e_smoke.test.mjs",
    "test:container": "npm run test:container:image && npm run test:container:freshness && npm run test:container:e2e",
    "typecheck": "tsc --noEmit",
    "validate:e2e-inventory": "node scripts/validate-e2e-inventory.mjs",
    "lint": "eslint --config eslint.config.mjs src",
    "lint:fix": "eslint --config eslint.config.mjs --fix src",
    "check:html-injection": "node scripts/check-html-injection.mjs",
    "check:fitness": "node scripts/check-architecture-fitness.mjs",
    "check:fitness:ci": "node scripts/check-architecture-fitness.mjs --ci",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check": "npm run typecheck && npm run lint && npm run check:html-injection && npm run check:fabricated-people && npm run check:idor && npm run check:idor-handlers && npm run check:body-slug-idor && npm run check:body-fk && npm run check:get-read-idor && npm run check:response-keys && npm run check:request-keys && npm run check:admin-email && npm run check:local-error-helpers && npm run check:ai-gateway && npm run check:no-openmeter && npm run check:unwired && npm run check:dbinsert && npm run check:dbupdate:ci && npm run check:dbexecute:ci && npm run check:duplicate-routes && npm run check:published-build && npm run check:orphan-flags && npm run check:admin-contract && npm run check:status-sweep && npm run check:system-org-seed && npm run check:trialing-drift && npm run format:check && npm run test:unit",
    "check:idor": "node scripts/check-idor-gates.mjs --ci",
    "check:idor-handlers": "node scripts/check-idor-handlers.mjs --ci",
    "check:body-slug-idor": "node scripts/check-body-slug-write-idor.mjs --ci",
    "check:body-fk": "node scripts/check-body-fk-write.mjs --ci",
    "check:get-read-idor": "node scripts/check-get-read-idor.mjs --ci",
    "check:response-keys": "node scripts/check-response-key-presence.mjs --ci",
    "check:request-keys": "node scripts/check-request-key-presence.mjs --ci",
    "check:admin-email": "node scripts/check-hardcoded-admin-email.mjs --ci",
    "check:published-build": "node scripts/check-published-without-build.mjs --ci",
    "check:local-error-helpers": "node scripts/check-local-error-helpers.mjs --ci",
    "check:ai-gateway": "node scripts/check-ai-gateway.mjs --ci",
    "check:no-openmeter": "node scripts/check-no-openmeter.mjs --ci",
    "check:unwired": "node scripts/check-unwired-endpoints.mjs --ci",
    "check:dbinsert": "node scripts/check-unchecked-dbinsert.mjs --ci",
    "check:dbinsert:ci": "node scripts/check-unchecked-dbinsert.mjs --ci",
    "check:dbupdate": "node scripts/check-unchecked-dbupdate.mjs",
    "check:dbupdate:ci": "node scripts/check-unchecked-dbupdate.mjs --ci",
    "check:dbexecute": "node scripts/check-unchecked-dbexecute.mjs",
    "check:dbexecute:ci": "node scripts/check-unchecked-dbexecute.mjs --ci",
    "check:duplicate-routes": "node scripts/check-duplicate-routes.mjs --ci",
    "check:orphan-flags": "node scripts/check-orphan-flag-gates.mjs",
    "check:status-sweep": "node scripts/check-status-sweep-no-retry.mjs",
    "check:system-org-seed": "node scripts/check-system-org-seed.mjs",
    "check:trialing-drift": "node scripts/check-trialing-drift.mjs",
    "check:admin-contract": "node scripts/validate-admin-contract.mjs",
    "gen:feature": "node scripts/gen-feature.mjs",
    "validate:features": "node scripts/validate-feature-manifests.mjs && node scripts/validate-feature-drift.mjs",
    "validate:features:quick": "node scripts/validate-feature-manifests.mjs && node scripts/validate-feature-drift.mjs --quick",
    "admin:verify": "node e2e/admin-verify/run-all.mjs",
    "audit:schema-applied": "node scripts/audit-schema-migrations-applied.mjs",
    "audit:flag-registration": "node scripts/audit-flag-registration.mjs",
    "check:fabricated-people": "node scripts/validate-no-fabricated-people.mjs",
    "test:scripts": "node --test scripts/__tests__/validate_no_fabricated_people.test.mjs scripts/__tests__/check_hardcoded_admin_email.test.mjs scripts/__tests__/check_local_error_helpers.test.mjs scripts/__tests__/check_duplicate_routes.test.mjs scripts/__tests__/check_status_sweep_no_retry.test.mjs scripts/__tests__/check_system_org_seed.test.mjs scripts/__tests__/check_trialing_drift.test.mjs scripts/__tests__/check_body_fk_write.test.mjs",
    "knip": "npx --yes knip --no-progress",
    "knip:report": "npx --yes knip --no-progress --reporter compact || true"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@better-auth/api-key": "^1.6.22",
    "@better-auth/passkey": "^1.6.22",
    "@better-auth/sso": "^1.6.22",
    "@cloudflare/containers": "^0.3.2",
    "@cloudflare/playwright": "^1.3.0",
    "@hono/standard-validator": "^0.2.2",
    "@hono/zod-validator": "^0.8.0",
    "@project-sites/shared": "file:../../packages/shared",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@types/json-schema": "^7.0.15",
    "better-auth": "^1.6.22",
    "diff": "^9.0.0",
    "effect": "^3.21.4",
    "hono": "^4.4.0",
    "hono-openapi": "^1.3.0",
    "jszip": "^3.10.1",
    "kysely": "^0.27.6",
    "kysely-d1": "^0.3.0",
    "lightningcss-wasm": "^1.32.0",
    "openapi-types": "^12.1.3",
    "partyserver": "^0.5.8",
    "quansync": "^0.2.11",
    "y-partyserver": "^2.2.0",
    "yjs": "^13.6.31",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@browserbasehq/stagehand": "^3.7.0",
    "@cloudflare/workers-types": "^4.20251011.0",
    "@playwright/test": "^1.53.0",
    "@swc/core": "^1.4.0",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.44.0"
  }
}
